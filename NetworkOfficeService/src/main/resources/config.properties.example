# ===========================================================================
# NetworkOfficeService — configuration template
#
# Copy to config.properties and replace every CHANGE_ME.
# config.properties is git-ignored; never commit real credentials.
# Full key reference: ../../../../docs/CONFIGURATION.md
# ===========================================================================

# --- Web / context ---------------------------------------------------------
web.view.prefix=/WEB-INF/views/
web.view.suffix=.jsp
platform_context_path=/sisp

# --- Internal proxy --------------------------------------------------------
# NOTE: the original file spelled this "iinner_proxy_ip" (double i). Nothing in
# this module reads the key, so it was inert; the correct spelling is used here.
inner_proxy_ip=127.0.0.1
inner_proxy_port=85

# --- Redis -----------------------------------------------------------------
# Format is host_port (underscore separated, not a URL).
redis_core_database=127.0.0.1_6380
# Cache / token TTL in MINUTES (JedisUtil multiplies by 60 internally).
redis_iface_expx=60

# --- JDBC ------------------------------------------------------------------
# NOTE: every datasource in this module is a Spring DriverManagerDataSource,
# which opens a new physical connection per request — there is no pool, so
# jdbc.minPoolSize / maxPoolSize / maxIdleTime / initialPoolSize are not read
# here. Add a real pool (c3p0/HikariCP) before putting this under load.

# --- Datasource: core platform schema --------------------------------------
# Bound to bean "sispDataSource".
jdbc.sisp.driverClassName=oracle.jdbc.driver.OracleDriver
jdbc.sisp.url=jdbc:oracle:thin:@127.0.0.1:1521:orcl
jdbc.sisp.username=CHANGE_ME
jdbc.sisp.password=CHANGE_ME

# --- Datasource: public query schema ---------------------------------------
# Bound to bean "sisppublicDataSource".
jdbc.sisp_public.driverClassName=oracle.jdbc.driver.OracleDriver
jdbc.sisp_public.url=jdbc:oracle:thin:@127.0.0.1:1521:orcl
jdbc.sisp_public.username=CHANGE_ME
jdbc.sisp_public.password=CHANGE_ME

# --- Datasource: integrated government-service schema ----------------------
# Bound to bean "sispYthdataSource".
jdbc.sisp_yth.driverClassName=oracle.jdbc.driver.OracleDriver
jdbc.sisp_yth.url=jdbc:oracle:thin:@127.0.0.1:1521:orcl
jdbc.sisp_yth.username=CHANGE_ME
jdbc.sisp_yth.password=CHANGE_ME

# --- Datasource: integrated government-service public schema ---------------
# Bound to bean "sispPublicYthDataSource".
jdbc.sisp_public_yth.driverClassName=oracle.jdbc.driver.OracleDriver
jdbc.sisp_public_yth.url=jdbc:oracle:thin:@127.0.0.1:1521:orcl
jdbc.sisp_public_yth.username=CHANGE_ME
jdbc.sisp_public_yth.password=CHANGE_ME

# --- Datasource: Neusoft face-recognition schema ---------------------------
# Bound to bean "drDataSource".
jdbc.drface.driverClassName=oracle.jdbc.driver.OracleDriver
jdbc.drface.url=jdbc:oracle:thin:@127.0.0.1:1521:orcl
jdbc.drface.username=CHANGE_ME
jdbc.drface.password=CHANGE_ME

# --- Electronic signature (PDF stamping) -----------------------------------
signpdf.data.url=http://127.0.0.1:80
# Must exist on the application host; a missing font fails at signing time.
signpdf.font.path=/usr/share/fonts/winfonts/ARIALUNI.TTF
signpdf.save.path=/data/deploy/pdfsign/pdfsign_temp
signpdf.template.path=/data/deploy/pdfsign/pdfsign_template/
signpdf.download.url=/sisp/signdownload/sign/download/

# --- File storage ----------------------------------------------------------
# Upload directories. Must be shared across nodes if you run more than one.
SCFILEPATH=/data/upload/sc
MATTERSCFILEPATH=/data/upload/matter

# --- Electronic licence library (API endpoints) ----------------------------
# List licences held by a person.
PERSONFILENUMBER=http://127.0.0.1:8003/license-api-release/m/v2/license/list/person
# List image info for a licence.
XGFILENUMBER=http://127.0.0.1:8003/license-api-release/m/v2/license/image_info
# Fetch a specific file stream.
XGIMAGEFILEID=http://127.0.0.1:8003/license-api-release/m/v2/license/image_file
