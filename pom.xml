<?xml version="1.0" encoding="UTF-8"?>
<!--
    Mestudy - aggregator POM.

    This aggregator is also the parent of the five modules. The modules retain
    their original groupId and version, while shared encoding and Java 8 compiler
    settings live here. A full reactor build still needs private dependencies.

    Build prerequisites are documented in docs/GETTING_STARTED.md. In short:
      * JDK 8 - both the build JDK and the language level (source/target 1.8).
        JDK 9+ builds will warn about the bootstrap classpath; JDK 11+ breaks
        Axis 1.x at runtime. See docs/TROUBLESHOOTING.md.
      * one module, NetPortalManagement, needs the private "bee.cloud"
        persistence framework. It is excluded from the default reactor; add it
        with -Pprivate-deps once those jars are in your local repository. See
        docs/GETTING_STARTED.md and docs/TROUBLESHOOTING.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.zengyunhua</groupId>
    <artifactId>mestudy</artifactId>
    <version>1.1.0</version>
    <packaging>pom</packaging>

    <name>Mestudy - social-insurance / e-government backend reference</name>
    <description>
        Reference implementation of a Chinese social-insurance / e-government backend:
        5 Spring MVC + MyBatis modules, 358 HTTP endpoints, Oracle multi-schema, Axis SOAP.
        Published for reference and educational use.
    </description>
    <url>https://github.com/zengyunhua/Mestudy</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <!-- Modules whose dependencies are all on Maven Central. `mvn package` at the
         root builds exactly these four, so a fresh clone gets a green build.

         The remaining one - NetPortalManagement - needs the private "bee.cloud"
         persistence framework. It is kept in the tree as reference material but is
         excluded from the default reactor, because a build that dies on an
         unresolvable artifact is worse than an explicit opt-in. Add it back with
         -Pprivate-deps once those jars are in your local repository. -->
    <modules>
        <module>IFaceSuportService</module>
        <module>IFaceSuperService_hn</module>
        <module>InterfaceFunction</module>
        <module>NetworkOfficeService</module>
    </modules>

    <profiles>
        <!-- Opt-in: the module that needs artifacts you have to supply yourself.
             See docs/TROUBLESHOOTING.md#build-fails-to-resolve-dependencies. -->
        <profile>
            <id>private-deps</id>
            <modules>
                <module>NetPortalManagement</module>
            </modules>
        </profile>
    </profiles>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Java 8 baseline. This is the single source of truth for the language
             level: module POMs must not override maven.compiler.source/target. -->
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.1.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.8.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.2.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-war-plugin</artifactId>
                    <version>3.3.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>2.22.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
