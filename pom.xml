<?xml version="1.0" encoding="UTF-8"?>
<!--
    Mestudy - aggregator POM.

    This aggregator is also the parent of the five modules. The modules retain
    their original groupId and version, while shared encoding and Java 8 compiler
    settings live here. A full reactor build still needs private dependencies.

    Build prerequisites are documented in docs/GETTING_STARTED.md. In short:
      * JDK 8 - both the build JDK and the language level (source/target 1.8).
        JDK 9+ builds will warn about the bootstrap classpath; JDK 11+ breaks
        Axis 1.x at runtime. See docs/TROUBLESHOOTING.md.
      * two modules need private bee / AA client artifacts. They are excluded
        from the default reactor; add them with -Pprivate-deps once those jars
        are in your local repository. See docs/GETTING_STARTED.md and
        docs/TROUBLESHOOTING.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.zengyunhua</groupId>
    <artifactId>mestudy</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>Mestudy</name>
    <description>
        Backend interface services for a Chinese social-insurance / human-resources
        public service platform. Published for reference and educational use.
    </description>
    <url>https://github.com/zengyunhua/Mestudy</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <!-- Modules whose dependencies are all on Maven Central. `mvn package` at the
         root builds exactly these three, so a fresh clone gets a green build.

         The other two - NetworkOfficeService and NetPortalManagement - need the
         private "bee" framework and an internal AA client. They are kept in the
         tree as reference material but are excluded from the default reactor,
         because a build that dies on unresolvable artifacts is worse than an
         explicit opt-in. Add them back with -Pprivate-deps once those jars are in
         your local repository. -->
    <modules>
        <module>IFaceSuportService</module>
        <module>IFaceSuperService_hn</module>
        <module>InterfaceFunction</module>
    </modules>

    <profiles>
        <!-- Opt-in: the two modules that need artifacts you have to supply
             yourself. See docs/TROUBLESHOOTING.md#build-fails-to-resolve-dependencies. -->
        <profile>
            <id>private-deps</id>
            <modules>
                <module>NetworkOfficeService</module>
                <module>NetPortalManagement</module>
            </modules>
        </profile>
    </profiles>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Java 8 baseline. This is the single source of truth for the language
             level: module POMs must not override maven.compiler.source/target. -->
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
    </properties>
</project>
